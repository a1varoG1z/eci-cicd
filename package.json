{
  "name": "playwright-bdd-ts",
  "version": "1.0.0",
  "description": "Framework de testing BDD con Playwright, Cucumber y TypeScript",
  "main": "index.js",
  "scripts": {
    "init": "npm install --legacy-peer-deps && npx playwright install",
    "test:local": "cross-env ENV=local BROWSER=chromium HEADLESS=false cucumber-js",
    "test:ci": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --tags @regresion",
    "test:local:slow": "cross-env ENV=local BROWSER=chromium HEADLESS=false SLOW_MO=1000 cucumber-js",
    "test:headless": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js",
    "test:debug": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js --tags @debug",
    "test:chromium": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js",
    "test:firefox": "cross-env ENV=local BROWSER=firefox HEADLESS=true cucumber-js",
    "test:webkit": "cross-env ENV=local BROWSER=webkit HEADLESS=true cucumber-js",
    "test:firefox:headless": "cross-env ENV=local BROWSER=firefox HEADLESS=true cucumber-js",
    "test:webkit:headless": "cross-env ENV=local BROWSER=webkit HEADLESS=true cucumber-js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"tests/**/*.ts\" \"*.ts\"",
    "test:chromium:eci": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --tags @eci",
    "test:regression": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @regression",
    "test:regression:id-1": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @id-1",
    "test:regression:prueba-eci": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @prueba-eci",
    "test:accessibility": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --tags @accesibility",
    "test:security": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @security",
    "test:performance": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @performance",
    "performance:playwright": "cross-env ENV=local HEADLESS=false PERF_WAIT_UNTIL=domcontentloaded PERF_NAV_RETRIES=0 tsx scripts/playwright-performance.ts",
    "performance:playwright:headless": "cross-env ENV=local HEADLESS=true PERF_WAIT_UNTIL=domcontentloaded PERF_NAV_RETRIES=0 tsx scripts/playwright-performance.ts",
    "performance:playwright:ci": "cross-env ENV=ci HEADLESS=true PERF_WAIT_UNTIL=domcontentloaded PERF_NAV_RETRIES=0 tsx scripts/playwright-performance.ts",
    "performance:playwright:debug": "cross-env ENV=local HEADLESS=true PERF_DEBUG_MATRIX=true PERF_NAV_RETRIES=1 PERF_WAIT_UNTIL=commit PERF_DISABLE_HTTP2=true tsx scripts/playwright-performance.ts",
    "performance:history": "npx open-cli reports/performance/playwright/performance-history.html",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "lighthouse:ci": "cross-env ENV=ci tsx scripts/lighthouse.ts",
    "test:prueba-eci:headless": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --tags @prueba-eci",
    "test:prueba-eci": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @prueba-eci"

  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "gherkin",
    "testing",
    "typescript",
    "page-object-model"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cucumber/cucumber": "^10.0.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "axe-html-reporter": "^2.2.11",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.55.0",
    "lighthouse": "^11.4.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.12.0",
    "typescript": "^5.3.3"
  }
}
