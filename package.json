{
  "name": "playwright-bdd-ts",
  "version": "1.0.0",
  "description": "Framework de testing BDD con Playwright, Cucumber y TypeScript",
  "main": "index.js",
  "scripts": {
    "init": "npm install --legacy-peer-deps && npx playwright install",
    "test:local": "cross-env ENV=local BROWSER=chromium HEADLESS=false cucumber-js",
    "test:ci": "cross-env ENV=ci BROWSER=chromium HEADLESS=true cucumber-js --tags @regresion",
    "test:local:slow": "cross-env ENV=local BROWSER=chromium HEADLESS=false SLOW_MO=1000 cucumber-js",
    "test:headless": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js",
    "test:debug": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js --tags @debug",
    "test:chromium": "cross-env ENV=local BROWSER=chromium HEADLESS=true cucumber-js",
    "test:firefox": "cross-env ENV=local BROWSER=firefox HEADLESS=true cucumber-js",
    "test:webkit": "cross-env ENV=local BROWSER=webkit HEADLESS=true cucumber-js",
    "test:firefox:headless": "cross-env ENV=local BROWSER=firefox HEADLESS=true cucumber-js",
    "test:webkit:headless": "cross-env ENV=local BROWSER=webkit HEADLESS=true cucumber-js",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"tests/**/*.ts\" \"*.ts\"",
    "test:chromium:eci": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @eci",
    "test:regression": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @regression",
    "test:accessibility": "cross-env ENV=ci BROWSER=chromium HEADLESS=false cucumber-js --tags @accesibility",
    "lighthouse:supermercado": "bash scripts/lighthouse-supermercado.sh",
    "lighthouse:supermercado:ci": "cross-env ENV=ci bash scripts/lighthouse-supermercado.sh"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "gherkin",
    "testing",
    "typescript",
    "page-object-model"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@cucumber/cucumber": "^10.0.0",
    "@cucumber/pretty-formatter": "^2.4.1",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "axe-html-reporter": "^2.2.11",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "env": "^0.0.2",
    "eslint": "^8.55.0",
    "lighthouse": "^11.4.0",
    "prettier": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.12.0",
    "typescript": "^5.3.3"
  }
}
